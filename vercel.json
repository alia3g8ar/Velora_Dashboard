{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "nestjs",
      "buildCommand": "npm run build && npm run migration:deploy"
    }
  },
  "rewrites": [
    {
      "source": "/graphql",
      "destination": { "service": "backend" }
    },
    {
      "source": "/graphql/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
