# Backend (NestJS) — Velora CRM
# Copy to `.env` and fill in your own values. Never commit `.env`.

# Used to sign and verify JWT access tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Database (MySQL) ---
TYPE_DB=mysql
HOST_DB=localhost
PORT_DB=3306
USERNAME_DB=root
PASSWORD_DB=your-database-password
DATABASE_DB=velora_crm
AUTOLOADENTITIES=true
# Migrations are the source of truth; keep this false in production.
SYNCHRONIZE=false
# Optional TLS (e.g. managed MySQL in the cloud).
# When DB_SSL_ENABLED=true:
#  - without DB_SSL_CA_BASE64 the connection is encrypted but the certificate
#    is not verified (works out of the box with providers like Aiven);
#  - set DB_SSL_CA_BASE64 to the Base64 encoding of your CA certificate
#    (e.g. `base64 -w0 ca.pem`) to also verify it.
DB_SSL_ENABLED=false
DB_SSL_CA_BASE64=

# --- HTTP ---
# Origin allowed by CORS (the frontend dev server). Must be a valid HTTP(S) URL.
FRONTEND_URL=http://localhost:5173
# The API listens on this port locally.
BACKEND_PORT=3001
