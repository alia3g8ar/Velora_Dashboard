# Velora CRM — frontend environment
# Copy to `.env` and adjust for your setup. Never commit `.env`.

# Base URL of the Velora backend. The GraphQL endpoint is <VITE_API_URL>/graphql.
VITE_API_URL=http://localhost:3001

# Optional: GraphQL WebSocket endpoint for the live provider.
# Leave unset to keep realtime disabled (CRUD uses refetch after mutations).
# VITE_WS_URL=ws://localhost:3001/graphql
